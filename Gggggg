use("ESP")
local COLORS = {
	Hijau = Color3.fromRGB(50, 220, 50), Merah = Color3.fromRGB(255, 60, 60), Biru = Color3.fromRGB(50, 120, 255),
	Kuning = Color3.fromRGB(255, 220, 0), Ungu = Color3.fromRGB(180, 50, 255), Pink = Color3.fromRGB(255, 80, 200),
	Putih = Color3.fromRGB(255, 255, 255), Orange = Color3.fromRGB(255, 140, 0),
}
local colorNames = { "Hijau", "Merah", "Biru", "Kuning", "Ungu", "Pink", "Putih", "Orange" }
local EC = { surv = COLORS.Putih, killer = COLORS.Merah, hook = COLORS.Ungu, gen = COLORS.Hijau, pallet = COLORS.Biru, zombie = COLORS.Orange }

local ESP = {}
local function espSync(cat, items)
	local store = ESP[cat]
	if not store then store = {} ESP[cat] = store end
	for inst, s in pairs(store) do
		if not items[inst] or not inst.Parent then
			if s.hl then s.hl:Destroy() end
			if s.bb then s.bb:Destroy() end
			store[inst] = nil
		end
	end
	for inst, d in pairs(items) do
		local s = store[inst]
		if not s then
			s = {}
			if not d.nohl then
				s.hl = Instance.new("Highlight")
				s.hl.FillTransparency = 1
				s.hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
				s.hl.Adornee = inst
				s.hl.Parent = inst
			end
			if d.text and d.part then
				local bb = Instance.new("BillboardGui")
				bb.AlwaysOnTop = true
				bb.Size = UDim2.fromOffset(150, 34)
				bb.StudsOffset = Vector3.new(0, d.off or 3, 0)
				bb.Adornee = d.part
				bb.Parent = gui
				local l = Instance.new("TextLabel", bb)
				l.Size = UDim2.fromScale(1, 1)
				l.BackgroundTransparency = 1
				l.Font = Enum.Font.GothamBold
				l.TextSize = 12
				l.TextColor3 = C.white
				l.TextStrokeTransparency = 0
				s.bb, s.lbl = bb, l
			end
			store[inst] = s
		end
		if s.hl then s.hl.FillColor = d.color s.hl.OutlineColor = d.color end
		if s.lbl then s.lbl.Text = d.text end
	end
end

local function dist(c)
	local a, b = hrp(), hrp(c)
	return (a and b) and math.floor((a.Position - b.Position).Magnitude) or 0
end
local stateText = { alive = "✅ Aman", knocked = "💀 Knocked", hooked = "⛓ Di-hook", carried = "🪝 Dibawa", dead = "💀 Mati", unknown = "?" }

local function syncAll()
	local items = {}
	if F.espPlayer then
		for _, p in ipairs(Players:GetPlayers()) do
			local t = team(p)
			if p ~= LP and p.Character and hrp(p.Character) and (t == "Survivors" or t == "Killer") then
				items[p.Character] = { color = t == "Killer" and EC.killer or EC.surv }
			end
		end
	end
	espSync("player", items)

	items = {}
	if F.espSurv then
		for _, p in ipairs(listTeam("Survivors")) do
			local s = state(p)
			local h = hum(p.Character)
			if s == "alive" and h and h.Health < h.MaxHealth then s = "🩸 Luka" else s = stateText[s] end
			items[p.Character] = { nohl = true, part = head(p.Character), off = 2.8, text = p.DisplayName .. " (" .. dist(p.Character) .. "m)\n" .. s }
		end
	end
	espSync("surv", items)

	items = {}
	if F.espKill then
		for _, p in ipairs(listTeam("Killer")) do
			items[p.Character] = { nohl = true, part = head(p.Character), off = 3.2, text = p.DisplayName .. "\n🔪 " .. dist(p.Character) .. "m" }
		end
	end
	espSync("kill", items)

	items = {}
	if F.espGen then
		for g in pairs(Cache.gens) do
			if g.Parent then
				local part = g:IsA("Model") and (g.PrimaryPart or g:FindFirstChildWhichIsA("BasePart", true)) or g
				if part then items[g] = { color = EC.gen, part = part, off = 4, text = getProgress(g) .. "%" } end
			end
		end
	end
	espSync("gen", items)

	items = {}
	if F.espHook then
		for _, h in ipairs(Cache.hooks) do if h.Parent then items[h] = { color = EC.hook } end end
	end
	espSync("hook", items)

	items = {}
	if F.espPallet then
		for pl in pairs(Cache.pallets) do if pl.Parent then items[pl] = { color = EC.pallet } end end
	end
	espSync("pallet", items)

