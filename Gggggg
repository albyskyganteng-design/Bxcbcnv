local lastGoal, lastSC = nil, 0
local function perfectGen()
	local gg = PG:FindFirstChild("SkillCheckPromptGui")
	local check = gg and gg:FindFirstChild("Check")
	if not check or not check.Visible then lastGoal = nil return end
	local line, goal = check:FindFirstChild("Line"), check:FindFirstChild("Goal")
	if not line or not goal then return end
	local gr = goal.Rotation
	if lastGoal ~= nil and math.abs(gr - lastGoal) % 360 > 2 then lastGoal = nil end
	if lastGoal ~= nil then return end
	local s = (104 + gr) % 360
	local e = (104 + gr + 12) % 360
	local x = line.Rotation % 360
	local inside
	if s <= e then inside = x >= s and x <= e else inside = x >= s or x <= e end
	if inside and tick() - lastSC > 0.08 then
		lastSC = tick()
		lastGoal = gr
		task.spawn(function()
			pcall(function() VIM:SendKeyEvent(true, Enum.KeyCode.Space, false, game) end)
			pcall(function() VIM:SendKeyEvent(false, Enum.KeyCode.Space, false, game) end)
			pressMobile("Survivor-mob", "action")
		end)
	end
end
