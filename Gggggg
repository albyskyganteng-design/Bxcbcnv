	btn.TextColor3 = C.white
	btn.Font = Enum.Font.GothamSemibold
	btn.TextSize = 14
	btn.TextXAlignment = Enum.TextXAlignment.Left
	local lc = Instance.new("Frame", f)
	lc.Size = UDim2.new(1, 0, 0, #options * 30)
	lc.Position = UDim2.new(0, 0, 0, 35)
	lc.BackgroundTransparency = 1
	Instance.new("UIListLayout", lc).SortOrder = Enum.SortOrder.LayoutOrder
	local function set(o)
		sel = o
		btn.Text = "  " .. text .. ": " .. o .. " [ v ]"
		if cb then task.spawn(cb, o) end
	end
	for _, o in ipairs(options) do
		local ob = Instance.new("TextButton", lc)
		ob.Size = UDim2.new(1, 0, 0, 30)
		ob.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
		ob.Text = o
		ob.TextColor3 = Color3.fromRGB(200, 200, 200)
		ob.Font = Enum.Font.Gotham
		ob.TextSize = 13
		ob.MouseButton1Click:Connect(function()
			open = false
			f.Size = UDim2.new(1, -6, 0, 35)
			set(o)
		end)
	end
	btn.MouseButton1Click:Connect(function()
		open = not open
		f.Size = UDim2.new(1, -6, 0, open and (35 + #options * 30) or 35)
	end)
	set(sel)
	Reg[key(text)] = { get = function() return sel end, set = set }
end

