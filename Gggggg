-- Brutal step
local function freeHook()
	local free = {}
	for _, h in ipairs(Cache.hooks) do
		if h.Parent then
			local busy = false
			for _, p in ipairs(Players:GetPlayers()) do
				local c = p.Character
				local pr = c and hrp(c)
				if p ~= LP and pr and (pr.Position - h.Position).Magnitude < 6 then
					local hp = c:GetAttribute("HookedProgress")
					if (hp ~= nil and hp < 100) or (c:GetAttribute("Knocked") == false and (c:GetAttribute("HookCount") or 0) > 0) then busy = true break end
				end
			end
			if not busy then free[#free + 1] = h end
		end
	end
	return #free > 0 and free[math.random(1, #free)] or nil
end
local function brutalStep()
	local me = hrp()
	if not me then return end
	local alive, knocked = {}, {}
	for _, p in ipairs(listTeam("Survivors")) do
		local s = state(p)
		if s == "alive" or s == "carried" then alive[#alive + 1] = p elseif s == "knocked" then knocked[#knocked + 1] = p end
	end
	if #alive > 0 then
		local t = alive[1]
		local th = hrp(t.Character)
		me.CFrame = CFrame.new((th.CFrame * CFrame.new(0, 0, 0.8)).Position, th.Position)
		Cam.CFrame = Cam.CFrame:Lerp(CFrame.new(Cam.CFrame.Position, head(t.Character).Position), 1 - F.smooth)
		local atk = R("Attacks", "BasicAttack")
		if atk and not F.brutalCD then
			F.brutalCD = true
			pcall(function() atk:FireServer() end)
			task.delay(0.05, function() F.brutalCD = false end)
		end
	elseif #knocked > 0 then
		local carry, hook = R("Carry", "CarrySurvivorEvent"), R("Carry", "HookEvent")
		if not carry or not hook then return end
		for _, t in ipairs(knocked) do
			if not F.brutal then break end
			local th = t.Character and hrp(t.Character)
			if th and state(t) == "knocked" then
				me.CFrame = CFrame.new(th.Position + Vector3.new(0, 0, 1), th.Position)
				task.wait(0.3)
				pcall(function() carry:FireServer(t.Character) end)
				task.wait(1)
				local h = freeHook()
				if h then
					me.CFrame = CFrame.new(h.Position + Vector3.new(0, 0, 1), h.Position)
					task.wait(0.3)
					for _ = 1, 7 do pcall(function() hook:FireServer(h) end) task.wait(0.01) end
					task.wait(0.15)
					pressMobile("Slasher-mob", "action")
					recentHook[t] = tick()
					notify("Hook " .. t.Name)
					task.wait(1)
				end
			end
		end
	end
end

