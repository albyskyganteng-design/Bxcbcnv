local function getProgress(m)
	local v = m:GetAttribute("Progress") or m:GetAttribute("RepairProgress") or m:GetAttribute("Repair")
	if v then return math.clamp(math.floor(tonumber(v) or 0), 0, 100) end
	for _, d in ipairs(m:GetDescendants()) do
		local n = d.Name:lower()
		if (n:find("progress") or n:find("repair")) and (d:IsA("NumberValue") or d:IsA("IntValue")) then
			return math.clamp(math.floor(d.Value), 0, 100)
		end
	end
	return 0
end

local function refreshCache()
	local gens, parts, hooks, pallets, zombies = {}, {}, {}, {}, {}
	local zset = idset("scp", "scp2", "scp3", "scp4", "scp5", "scp6", "scp7", "scp8")
	for _, d in ipairs(workspace:GetDescendants()) do
		local ln = d.Name:lower()
		if (d:IsA("Model") or d:IsA("BasePart")) and ln:find("generator") and not inPlayer(d) then
			local m = d
			if d:IsA("BasePart") and d.Parent:IsA("Model") and d.Parent ~= workspace and d.Parent.Name:lower():find("generator") then m = d.Parent end
			gens[m] = true
			if d:IsA("BasePart") then parts[#parts + 1] = d end
		end
		if d:IsA("BasePart") and (d:GetAttribute("Spike") ~= nil or ln == "hook" or ln:find("hookpoint")) then hooks[#hooks + 1] = d end
		if d:IsA("BasePart") and d.Name:find("PalletPoint") then
			pallets[(d.Parent and d.Parent:IsA("Model") and d.Parent ~= workspace) and d.Parent or d] = true
		end
		if d:IsA("Model") and zset[ln] and d:FindFirstChildOfClass("Humanoid") and d:FindFirstChild("HumanoidRootPart") then zombies[#zombies + 1] = d end
	end
	Cache.gens, Cache.genParts, Cache.hooks, Cache.pallets, Cache.zombies = gens, parts, hooks, pallets, zombies
end

