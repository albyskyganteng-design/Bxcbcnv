local function nearest(list)
	local me = hrp()
	if not me then return end
	local best, bd
	for _, p in ipairs(list) do
		local d = (hrp(p.Character).Position - me.Position).Magnitude
		if not bd or d < bd then best, bd = p, d end
	end
	return best, bd
end

local function state(p)
	local c = p.Character
	if not c then return "unknown" end
	if c:GetAttribute("IsCarried") == true then return "carried" end
	if c:GetAttribute("IsHooked") == true then return "hooked" end
	if recentHook[p] and tick() - recentHook[p] < 5 then return "hooked" end
	if c:GetAttribute("Knocked") == true then return "knocked" end
	local h = hum(c)
	if h and h.Health <= 0 then return "dead" end
	return "alive"
end

