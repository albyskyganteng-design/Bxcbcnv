local flyBV, flyBG, flyConn
local function stopFly()
	if flyConn then flyConn:Disconnect() flyConn = nil end
	if flyBV then flyBV:Destroy() flyBV = nil end
	if flyBG then flyBG:Destroy() flyBG = nil end
	local h = hum()
	if h then h:ChangeState(Enum.HumanoidStateType.GettingUp) h.AutoRotate = true end
end
local function startFly()
	stopFly()
	local r, h = hrp(), hum()
	if not r or not h then return end
	h:ChangeState(Enum.HumanoidStateType.Physics)
	h.AutoRotate = false
	flyBV = Instance.new("BodyVelocity", r)
	flyBV.MaxForce = Vector3.new(1e9, 1e9, 1e9)
	flyBV.Velocity = Vector3.zero
	flyBG = Instance.new("BodyGyro", r)
	flyBG.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
	flyBG.P = 15000
	flyBG.D = 500
	flyConn = RunService.RenderStepped:Connect(function()
		local hh = hum()
		if not hh or not flyBV then return end
		local md = hh.MoveDirection
		if md.Magnitude > 0 then
			local cf = Cam.CFrame
			local v = cf.LookVector * md:Dot(cf.LookVector) + cf.RightVector * md:Dot(cf.RightVector)
			if v.Magnitude > 0 then flyBV.Velocity = v.Unit * F.flySpeed end
		else
			flyBV.Velocity = Vector3.zero
		end
		flyBG.CFrame = Cam.CFrame
	end)
end

local spinConn, spinAng = nil, 0
local function stopSpin()
	if spinConn then spinConn:Disconnect() spinConn = nil end
	local h = hum()
	if h then h.AutoRotate = true end
end
local function startSpin()
	stopSpin()
