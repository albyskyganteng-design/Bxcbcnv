-- Heartbeat: speed hack, parry-less checks, anti killer, perfect gen
RunService.Heartbeat:Connect(function()
	local h = hum()
	if F.speed and h and h.WalkSpeed ~= F.speedVal then h.WalkSpeed = F.speedVal end
	if F.perfect then perfectGen() end

	local r = hrp()
	if F.anti and r and not F.antiCD then
		local k, d = nearest(listTeam("Killer"))
		if k and d <= F.antiRadius then
			F.antiCD = true
			local spots = {}
			refreshCache()
			for g in pairs(Cache.gens) do spots[#spots + 1] = posOf(g) end
			for pl in pairs(Cache.pallets) do spots[#spots + 1] = posOf(pl) end
			local safe
			for _, sp in ipairs(spots) do
				local ok = true
				for _, p in ipairs(Players:GetPlayers()) do
					local pr = p.Character and hrp(p.Character)
					if pr and (pr.Position - sp).Magnitude < 20 then ok = false break end
				end
				if ok then safe = sp break end
			end
			if safe then
				r.CFrame = CFrame.new(safe + Vector3.new(0, 3, 0))
				notify("🏃 ANTI KILLER: TP aman")
			else
				r.CFrame = r.CFrame * CFrame.new(0, -40, 0)
				notify("🕳 Ga ada tempat aman, jeblos")
			end
			task.delay(8, function() F.antiCD = false end)
		end
	end
end)

-- RenderStepped: lock aim, FOV
RunService.RenderStepped:Connect(function()
	if F.fov and Cam.FieldOfView ~= F.fovVal then Cam.FieldOfView = F.fovVal end

	-- body lock / flashlight lock
	local locking = (F.bodyLock and L.body) or (F.flashAim and L.flash)
	local h = hum()
	if locking then
		local part = (F.flashAim and L.flash and killerPart()) or aimPart()
		if part then
			local tpos = (F.flashAim and L.flash) and head(part.Parent).Position or part.Position
			Cam.CFrame = CFrame.new(Cam.CFrame.Position, tpos)
			local r = hrp()
			if r then
				local v = Vector3.new(tpos.X, r.Position.Y, tpos.Z) - r.Position
				if v.Magnitude > 0.01 then r.CFrame = CFrame.new(r.Position, r.Position + v.Unit) end
			end
		end
		if h and not F.lockedRot then F.lockedRot = true h.AutoRotate = false end
	elseif F.lockedRot then
		F.lockedRot = false
		if h and not (flyConn or spinConn or mwConn) then h.AutoRotate = true end
	end

	-- auto lock aim (killer)
	if F.autoLock then
		local list = {}
		for _, p in ipairs(listTeam("Survivors")) do
			if p.Character:GetAttribute("Knocked") ~= true then list[#list + 1] = p end
		end
		local t = nearest(list)
		if t then
			Cam.CFrame = Cam.CFrame:Lerp(CFrame.new(Cam.CFrame.Position, head(t.Character).Position), 1 - F.smooth)
		end
	end
end)

