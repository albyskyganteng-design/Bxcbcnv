-- hook animasi (karakter sendiri + killer untuk auto parry)
local myHum
local hooked = setmetatable({}, { __mode = "k" })
local function onMyAnim(track)
	local id = animId(track)
	if F.veil and IDS.veil[id] then throwSpear() end
	if F.silent and IDS.shoot[id] and not F.shootCD then
		F.shootCD = true
		task.delay(0.01, shootOnce)
		task.delay(0.3, function() F.shootCD = false end)
	end
	if F.bodyLock then
		if IDS.shoot[id] then L.body = true elseif IDS.off[id] then L.body = false end
	end
	if F.flashAim then
		if IDS.flash[id] then L.flash = true elseif IDS.off[id] then L.flash = false end
	end
end

task.spawn(function()
	while true do
		task.wait(1)
		pcall(function()
			local h = hum()
			if h and h ~= myHum then
				myHum = h
				h.AnimationPlayed:Connect(onMyAnim)
				L.body, L.flash = false, false
				if F.jump then applyJump() end
				if F.mw then startMW() end
			end
			for _, p in ipairs(Players:GetPlayers()) do
				if p ~= LP and team(p) == "Killer" and p.Character then
					local kh = hum(p.Character)
					if kh and not hooked[kh] then
						local kc = p.Character
						hooked[kh] = kh.AnimationPlayed:Connect(function(t)
							if IDS.parry[animId(t)] then tryParry(kc) end
						end)
					end
				end
			end
		end)
	end
end)

