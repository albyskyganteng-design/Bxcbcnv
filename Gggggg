local function throwSpear()
	if F.veilBusy then return end
	local spear = R("Killers", "Veil", "Spearthrow")
	local r = hrp()
	if not spear or not r then return end
	local origin = r.Position + r.CFrame.LookVector * 3 + Vector3.new(0, 1.5, 0)
	local best, bd
	for _, p in ipairs(listTeam("Survivors")) do
		if state(p) == "alive" then
			local d = (hrp(p.Character).Position - origin).Magnitude
			if not bd or d < bd then best, bd = p, d end
		end
	end
	if not best then return end
	local tp = head(best.Character).Position
	local v = hrp(best.Character).AssemblyLinearVelocity
	local fv = Vector3.new(v.X, 0, v.Z)
	if F.veilPredict > 0 and fv.Magnitude >= 0.5 then tp = tp + fv.Unit * F.veilPredict end
	tp = tp + Vector3.new(0, F.veilOffset, 0)
	local g = workspace.Gravity
	local d = tp - origin
	local flat = Vector3.new(d.X, 0, d.Z)
	local fm = flat.Magnitude
	local sp = F.veilSpeed
	local t = fm > 0.01 and fm / sp or d.Magnitude / sp
	for _ = 1, 6 do
		local vy = (d.Y + 0.5 * g * 0.5 * t * t) / t
		local vh = fm > 0.01 and fm / t or 0
		local tot = math.sqrt(vh * vh + vy * vy)
		if tot > 0.01 then t = t * (tot / sp) end
	end
	local vy = (d.Y + 0.5 * g * 0.5 * t * t) / t
	local vec = (fm > 0.01 and flat.Unit or Vector3.new(0, 0, 1)) * (fm > 0.01 and fm / t or 0) + Vector3.new(0, vy, 0)
	F.veilBusy = true
	pcall(function() spear:FireServer(vec.Unit, math.clamp(vec.Magnitude, 50, 800), origin) end)
	task.delay(0.5, function() F.veilBusy = false end)
end
